# MILPA RESILIENTE — variables de entorno. Copiar a .env (NO versionar .env). Sin secretos reales aquí.
# Generar secretos:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Base de datos --------------------------------------------------------------------------
POSTGRES_DB=milpa
POSTGRES_USER=milpa_owner                # propietario: solo migraciones (entrypoint)
POSTGRES_PASSWORD=                       # OBLIGATORIA (docker compose)
APP_DB_ROLE=milpa_app                    # rol de la aplicación: sin SUPERUSER ni BYPASSRLS
APP_DB_PASSWORD=                         # OBLIGATORIA (docker compose)
# Fuera de Docker (desarrollo local con uv):
# DATABASE_URL=postgresql+psycopg://milpa_app:<APP_DB_PASSWORD>@127.0.0.1:5432/milpa
# MIGRATION_DATABASE_URL=postgresql+psycopg://milpa_owner:<POSTGRES_PASSWORD>@127.0.0.1:5432/milpa

# ---- Definidas por la especificación (R3 §7) -----------------------------------------------
DATA_DIR=./data                          # raíz de datos (Parquet curado, resultados, PDFs)
JWT_SECRET=                              # OBLIGATORIA, >= 32 caracteres; en production no puede ser un ejemplo
JWT_TTL_MINUTES=15                       # vida del token; valor operativo [Pendiente de decisión]
EARTHDATA_TOKEN=                         # solo se pasa a la ETL (proceso hijo) si ETL_INGEST_ENABLED=true
ETL_INGEST_ENABLED=false                 # true: el trabajo zone_ingest invoca `milpa-etl` (requiere red a NASA)
ETL_STEP_TIMEOUT_SECONDS=3600
ENABLE_EXACT_GEOMETRY=false              # true NO está implementado en el MVP (nivel B)
MAP_TILE_URL=                            # configuración compartida con R4
MAP_ATTRIBUTION=
MAX_UPLOAD_MB=2                          # tamaño máximo del CSV de suelo [valor operativo pendiente]
RATE_LIMIT_PER_MIN=120                   # por IP y por usuario [valor operativo pendiente]
MILPA_MODE=sandbox                       # sandbox | production
DEMO_READONLY=false                      # true: demostración de solo lectura

# ---- Extensiones de R3 -------------------------------------------------------------------------
CORS_ORIGINS=                            # lista separada por comas; vacío = sin CORS; '*' está prohibido
# JWT_SECRET_PREVIOUS=                   # rotación de clave: solo verifica tokens ya emitidos
# JOB_MAX_WORKERS=2                      # trabajos concurrentes (1-2 en el MVP; a medir)
# JOB_MAX_ATTEMPTS=3
# JOB_TIMEOUT_SECONDS=0                  # 0 = sin timeout (política por tipo: [Pendiente])
# DISPLAY_GRID_M=1000                    # rejilla de generalización (mínimo 1000; DP-13)
# LOG_LEVEL=INFO
RUN_MIGRATIONS=true                      # el contenedor migra al arrancar
APP_PUBLISH=127.0.0.1:8000               # puerto publicado de la app
